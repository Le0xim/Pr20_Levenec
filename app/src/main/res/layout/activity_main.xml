<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#666666"
    tools:context=".MainActivity">

    <!-- Верхняя полоса дороги -->

    <!-- Нижняя полоса дороги -->

    <!-- Разделительная линия -->

    <!-- Финишная клетка справа -->

    <!-- Верхняя машина -->

    <!-- Нижняя машина -->

    <!-- Панель кнопок -->

    <View
        android:id="@+id/roadTop"
        android:layout_width="850dp"
        android:layout_height="177dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="41dp"
        android:layout_marginBottom="231dp"
        android:background="@drawable/road"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="VisualLintBounds" />

    <View
        android:id="@+id/roadBottom"
        android:layout_width="850dp"
        android:layout_height="180dp"
        android:layout_marginTop="181dp"
        android:layout_marginEnd="41dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/road"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="VisualLintBounds" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="93dp"
        android:layout_height="52dp"
        android:layout_marginStart="390dp"
        android:layout_marginTop="318dp"
        android:layout_marginEnd="408dp"
        android:layout_marginBottom="41dp"
        android:layout_weight="1"
        android:backgroundTint="@color/green"
        android:text="@string/text1"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TextContrastCheck" />

    <Button
        android:id="@+id/btnRight"
        android:layout_width="101dp"
        android:layout_height="49dp"
        android:layout_marginStart="152dp"
        android:layout_marginTop="318dp"
        android:layout_marginEnd="638dp"
        android:layout_marginBottom="44dp"
        android:layout_weight="1"
        android:backgroundTint="@color/purple"
        android:text="@string/text2"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="DuplicateSpeakableTextCheck" />

    <Button
        android:id="@+id/btnLeft"
        android:layout_width="97dp"
        android:layout_height="51dp"
        android:layout_marginStart="608dp"
        android:layout_marginTop="318dp"
        android:layout_marginEnd="186dp"
        android:layout_marginBottom="42dp"
        android:layout_weight="1"
        android:backgroundTint="@color/red"
        android:text="@string/text2"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TextContrastCheck" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="39dp"
        android:layout_height="114dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="66dp"
        android:layout_marginEnd="828dp"
        android:layout_marginBottom="231dp"
        android:rotation="90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/first_car"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="47dp"
        android:layout_height="193dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="202dp"
        android:layout_marginEnd="820dp"
        android:layout_marginBottom="16dp"
        android:rotation="90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/second_car"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="57dp"
        android:layout_height="361dp"
        android:layout_marginStart="839dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="47dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/roadTop"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/finish_line"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>